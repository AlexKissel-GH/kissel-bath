---
import { settings } from '../lib/seo';

interface Props {
  heading?: string;
  subheading?: string;
}
const {
  heading = 'Ready to love your bathroom or kitchen again?',
  subheading = 'Schedule your free in-home estimate today. Fixed, itemized pricing — no surprises, no pressure.',
} = Astro.props;
---

<section class="bg-brand-dark" aria-labelledby="cta-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 text-center">
    <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold text-white tracking-tight">{heading}</h2>
    <p class="mt-4 text-lg text-slate-300 max-w-2xl mx-auto">{subheading}</p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 min-h-[44px] w-full sm:w-auto bg-brand-accent text-white font-semibold rounded-xl hover:bg-amber-700 transition-colors"
      >
        Get My Free Estimate
      </a>
      <a
        href={settings.phoneHref}
        class="inline-flex items-center justify-center gap-2 px-8 py-4 min-h-[44px] w-full sm:w-auto bg-white/10 text-white font-semibold rounded-xl border border-white/20 hover:bg-white/20 transition-colors"
        aria-label={`Call us at ${settings.phone}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        Call {settings.phone}
      </a>
    </div>
    <p class="mt-6 text-sm text-slate-400">Mon–Fri 8am–6pm · Sat 9am–2pm · Sun closed</p>
  </div>
</section>
