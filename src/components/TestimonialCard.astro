---
import type { CollectionEntry } from 'astro:content';
import Stars from './Stars.astro';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}
const { testimonial } = Astro.props;
const { name, text, rating, service } = testimonial.data;
---

<figure class="flex flex-col bg-white rounded-2xl border border-slate-200 p-6">
  <Stars rating={rating} />
  <blockquote class="mt-4 text-sm leading-relaxed flex-1">
    <p>&ldquo;{text}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-5 pt-4 border-t border-slate-100">
    <div class="font-semibold text-brand-dark text-sm">{name}</div>
    {service && <div class="text-xs text-brand-muted mt-0.5">{service}</div>}
  </figcaption>
</figure>
