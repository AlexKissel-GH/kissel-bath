---
import { settings } from '../lib/seo';

const GBP_URL =
  "https://www.google.com/maps/place/Kissel's+Bath+for+US/@39.7196944,-104.7925253,17z/data=!4m6!3m5!1s0x876c7dca5fdaf431:0xc0d4d25ad129929e!8m2!3d39.7196944!4d-104.7925253!16s%2Fg%2F11h94tpl17";
const HOUZZ_URL = 'https://www.houzz.com/professionals/kitchen-and-bath-remodelers/kissel-s-bath-for-us-pfvwus-pf~221904293';
const FACEBOOK_URL = 'https://www.facebook.com/bath4us';

const serviceLinks = [
  { label: 'Bathroom Remodeling', href: '/services/bathroom-remodeling-denver/' },
  { label: 'Tub-to-Shower Conversion', href: '/services/tub-to-shower-conversion-denver/' },
  { label: 'Kitchen Remodeling', href: '/services/kitchen-remodeling-denver/' },
  { label: 'Cabinet Refacing', href: '/services/cabinet-refacing-denver/' },
  { label: 'Walk-In Shower Installation', href: '/services/walk-in-shower-installation-denver/' },
  { label: 'Accessibility / ADA', href: '/services/ada-bathroom-remodeling-denver/' },
  { label: 'All Services', href: '/services' },
  { label: 'Pricing', href: '/pricing' },
];

const companyLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
  { label: 'Free Estimate', href: '/contact' },
];

// City pages are created in phase 2; until then these URLs intentionally 404.
const areaLinks = [
  { label: 'Aurora', href: '/locations/bathroom-remodeling-aurora-co/' },
  { label: 'Parker', href: '/locations/bathroom-remodeling-parker-co/' },
  { label: 'Highlands Ranch', href: '/locations/bathroom-remodeling-highlands-ranch-co/' },
  { label: 'Lakewood', href: '/locations/bathroom-remodeling-lakewood-co/' },
  { label: 'Littleton', href: '/locations/bathroom-remodeling-littleton-co/' },
];
---

<footer class="bg-brand-dark text-slate-300" data-track="footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div>
        <a href="/" class="leading-tight inline-block" aria-label="Kissel's Bath and Kitchen — home">
          <div class="text-lg font-bold text-white tracking-tight">Kissel's Bath</div>
          <div class="text-lg font-bold text-white tracking-tight">and Kitchen</div>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-slate-400">
          Family-owned bathroom and kitchen remodeling in Denver metro. Licensed, insured &amp; EPA Lead-Safe certified.
        </p>
        <p class="mt-4 text-sm text-slate-400">
          <span class="text-amber-500 font-semibold">★ {settings.rating}</span> on Google · {settings.reviewCount} reviews
        </p>
        <!-- Social profiles -->
        <ul class="mt-5 flex items-center gap-2">
          <li>
            <a
              href={GBP_URL}
              target="_blank"
              rel="noopener"
              aria-label="Kissel's Bath and Kitchen on Google Maps"
              class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/10 text-slate-300 hover:bg-white/20 hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.85 3.19-1.79 4.13-1.15 1.15-2.93 2.4-6.05 2.4-4.83 0-8.6-3.89-8.6-8.72s3.77-8.72 8.6-8.72c2.6 0 4.51 1.03 5.91 2.35l2.31-2.31C18.75 1.44 16.13 0 12.48 0 5.87 0 .31 5.39.31 12s5.56 12 12.17 12c3.57 0 6.27-1.17 8.37-3.36 2.16-2.16 2.84-5.21 2.84-7.67 0-.76-.05-1.46-.17-2.05H12.48z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href={FACEBOOK_URL}
              target="_blank"
              rel="noopener"
              aria-label="Kissel's Bath and Kitchen on Facebook"
              class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/10 text-slate-300 hover:bg-white/20 hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.07C24 5.45 18.63.07 12 .07S0 5.45 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.52c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.38C19.61 23.02 24 18.06 24 12.07z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href={HOUZZ_URL}
              target="_blank"
              rel="noopener"
              aria-label="Kissel's Bath and Kitchen on Houzz"
              class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/10 text-slate-300 hover:bg-white/20 hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 1.5L2.5 7v10L12 22.5 21.5 17V7L12 1.5zm3.8 15.1h-2.9v-3.1h-1.8v3.1H8.2V7.4h2.9v3h1.8v-3h2.9v9.2z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <nav aria-label="Footer services">
        <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex items-center min-h-[32px] hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Company + Service areas -->
      <div>
        <nav aria-label="Footer company">
          <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Company</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            {companyLinks.map((link) => (
              <li>
                <a href={link.href} class="inline-flex items-center min-h-[32px] hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Footer service areas">
          <h2 class="mt-8 text-sm font-semibold text-white uppercase tracking-wider">Service Areas</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            {areaLinks.map((link) => (
              <li>
                <a href={link.href} class="inline-flex items-center min-h-[32px] hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-slate-400 leading-relaxed">
            Plus Denver, Broomfield &amp; 15+ more communities across the metro.
          </p>
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h2 class="text-sm font-semibold text-white uppercase tracking-wider">Contact</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={settings.phoneHref} class="inline-flex items-center gap-2 text-emerald-400 font-semibold hover:text-emerald-300 transition-colors min-h-[44px]">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              {settings.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${settings.email}`} class="hover:text-white transition-colors break-all">{settings.email}</a>
          </li>
          <li class="text-slate-400">{settings.address}</li>
          <li class="text-slate-400">{settings.hours}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-slate-500">
      <p>© 2026 Kissel's Bath and Kitchen. All rights reserved.</p>
      <p>Licensed &amp; Insured GC · EPA Lead-Safe Firm NAT-F212803-1</p>
    </div>

    <!-- Legal -->
    <nav aria-label="Legal" class="mt-4 flex flex-wrap items-center justify-center sm:justify-start gap-x-6 gap-y-2 text-sm text-slate-500">
      <a href="/privacy-policy/" class="inline-flex items-center min-h-[44px] hover:text-slate-300 transition-colors">Privacy Policy</a>
      <a href="/terms/" class="inline-flex items-center min-h-[44px] hover:text-slate-300 transition-colors">Terms of Service</a>
      <button
        type="button"
        id="manage-cookies"
        class="inline-flex items-center min-h-[44px] hover:text-slate-300 transition-colors underline-offset-2 hover:underline"
      >
        Manage cookies
      </button>
    </nav>
  </div>
</footer>

<script is:inline>
  (function () {
    var btn = document.getElementById('manage-cookies');
    if (!btn) return;
    btn.addEventListener('click', function () {
      if (typeof window.__kisselShowConsent === 'function') window.__kisselShowConsent();
    });
  })();
</script>
