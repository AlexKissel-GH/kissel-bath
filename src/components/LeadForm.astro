---
import { getCollection } from 'astro:content';

interface Props {
  formLocation: string;
  compact?: boolean;
  dark?: boolean; // render on dark background (e.g. brand-dark CTA sections)
}

const { formLocation, compact = false, dark = false } = Astro.props;

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const bathroomServices = services.filter((s) => s.data.category === 'bathroom');
const kitchenServices = services.filter((s) => s.data.category === 'kitchen');

const uid = `lf-${formLocation}`;
const inputClass =
  'w-full px-4 py-3 min-h-[44px] rounded-xl border border-slate-300 bg-white text-brand-dark placeholder:text-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-brand-accent transition-colors';
const labelClass = 'block text-sm font-semibold text-brand-dark mb-1.5';
---

<!--
  Netlify Forms: detected at deploy time; only stores submissions when deployed
  on Netlify. Locally it simply navigates to the thank-you page.
-->
<form
  name="home-lead-form"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action={`/thank-you/?from=${formLocation}`}
  class:list={['lead-form grid gap-4', compact ? 'grid-cols-1' : 'sm:grid-cols-2 gap-5']}
  data-form-location={formLocation}
  novalidate
>
  <input type="hidden" name="form-name" value="home-lead-form" />
  <input type="hidden" name="form-location" value={formLocation} />
  <p class="hidden" aria-hidden="true">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>

  <div>
    <label for={`${uid}-name`} class={labelClass}>Full name *</label>
    <input type="text" id={`${uid}-name`} name="name" required autocomplete="name" placeholder="John Smith" class={inputClass} />
  </div>

  <div>
    <label for={`${uid}-phone`} class={labelClass}>Phone *</label>
    <input
      type="tel"
      id={`${uid}-phone`}
      name="phone"
      required
      autocomplete="tel"
      inputmode="tel"
      placeholder="(720) 555-0134"
      class={`${inputClass} phone-mask`}
    />
  </div>

  <div>
    <label for={`${uid}-zip`} class={labelClass}>ZIP code *</label>
    <input
      type="text"
      id={`${uid}-zip`}
      name="zip"
      required
      autocomplete="postal-code"
      inputmode="numeric"
      pattern="[0-9]{5}"
      maxlength="5"
      placeholder="80011"
      class={inputClass}
    />
  </div>

  <div>
    <label for={`${uid}-email`} class={labelClass}>Email me a copy of my estimate (optional)</label>
    <input type="email" id={`${uid}-email`} name="email" autocomplete="email" placeholder="john@example.com" class={inputClass} />
  </div>

  <div class={compact ? '' : 'sm:col-span-2'}>
    <label for={`${uid}-service`} class={labelClass}>Service</label>
    <select id={`${uid}-service`} name="service" class={inputClass}>
      <optgroup label="Bathroom Services">
        {bathroomServices.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
      </optgroup>
      <optgroup label="Kitchen Services">
        {kitchenServices.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
      </optgroup>
      <option value="Not sure yet" selected>Not sure yet</option>
    </select>
  </div>

  <div class={compact ? '' : 'sm:col-span-2'}>
    <label class="flex items-start gap-3 cursor-pointer">
      <input
        type="checkbox"
        name="consent"
        value="yes"
        required
        class="mt-1 w-5 h-5 shrink-0 rounded border-slate-300 text-emerald-600 focus:ring-emerald-600"
      />
      <span class:list={['text-sm leading-relaxed', dark ? 'text-slate-300' : 'text-brand-body']}>
        I agree to receive calls/texts about my project. Msg &amp; data rates may apply.
        See our <a href="/privacy-policy/" class="font-semibold underline underline-offset-2">Privacy Policy</a>.
      </span>
    </label>
  </div>

  <div class={compact ? '' : 'sm:col-span-2'}>
    <button
      type="submit"
      class="lead-form-submit w-full inline-flex items-center justify-center px-8 py-4 min-h-[44px] bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <span class="submit-label">Get My Free Estimate</span>
      <span class="submit-loading hidden">Sending…</span>
    </button>
  </div>
</form>

<script is:inline>
  (function () {
    var ERROR_CLASS = ['border-red-500', 'ring-2', 'ring-red-200'];

    // Phone input mask: (XXX) XXX-XXXX
    function maskPhone(value) {
      var digits = value.replace(/\D/g, '').slice(0, 10);
      if (digits.length === 0) return '';
      if (digits.length < 4) return '(' + digits;
      if (digits.length < 7) return '(' + digits.slice(0, 3) + ') ' + digits.slice(3);
      return '(' + digits.slice(0, 3) + ') ' + digits.slice(3, 6) + '-' + digits.slice(6);
    }

    document.querySelectorAll('.lead-form').forEach(function (form) {
      var phone = form.querySelector('.phone-mask');
      if (phone) {
        phone.addEventListener('input', function () {
          phone.value = maskPhone(phone.value);
        });
      }

      // Clear error highlighting as the visitor types
      form.addEventListener('input', function (e) {
        if (e.target && e.target.classList) {
          ERROR_CLASS.forEach(function (c) { e.target.classList.remove(c); });
        }
      });

      form.addEventListener('submit', function (e) {
        // Client-side validation with error highlighting
        var valid = true;
        form.querySelectorAll('[required]').forEach(function (field) {
          var ok = field.type === 'checkbox' ? field.checked : field.checkValidity();
          if (!ok) {
            valid = false;
            if (field.type !== 'checkbox') {
              ERROR_CLASS.forEach(function (c) { field.classList.add(c); });
            }
          } else if (field.pattern && field.value && !new RegExp('^(?:' + field.pattern + ')$').test(field.value)) {
            valid = false;
            ERROR_CLASS.forEach(function (c) { field.classList.add(c); });
          }
        });
        if (!valid) {
          e.preventDefault();
          var firstInvalid = form.querySelector('.border-red-500');
          if (firstInvalid) firstInvalid.focus();
          return;
        }
        // Loading state
        var btn = form.querySelector('.lead-form-submit');
        if (btn) {
          btn.disabled = true;
          var label = btn.querySelector('.submit-label');
          var loading = btn.querySelector('.submit-loading');
          if (label) label.classList.add('hidden');
          if (loading) loading.classList.remove('hidden');
        }
      });
    });
  })();
</script>
