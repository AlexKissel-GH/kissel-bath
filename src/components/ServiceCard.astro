---
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
  linkPrefix?: string;
}
const { service, linkPrefix = '/services' } = Astro.props;
const { title, priceLabel, duration, shortDescription, image, imageAlt, featured } = service.data;
const href = `${linkPrefix}#${service.slug}`;
---

<article class="relative flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:border-slate-300 transition-all">
  {featured && (
    <span class="absolute top-4 left-4 z-10 inline-flex items-center px-3 py-1 rounded-full bg-brand-accent text-white text-xs font-semibold uppercase tracking-wide">
      Most Popular
    </span>
  )}
  <a href={href} class="block" tabindex="-1" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt}
      width="1024"
      height="768"
      loading="lazy"
      decoding="async"
      class="w-full aspect-[4/3] object-cover"
    />
  </a>
  <div class="flex flex-col flex-1 p-6">
    <h3 class="text-lg font-bold text-brand-dark">
      <a href={href} class="hover:text-brand-accent transition-colors">{title}</a>
    </h3>
    <div class="mt-2 flex items-center gap-3 text-sm">
      <span class="font-semibold text-brand-accent">{priceLabel}</span>
      <span class="text-brand-muted" aria-hidden="true">·</span>
      <span class="text-brand-muted">{duration}</span>
    </div>
    <p class="mt-3 text-sm leading-relaxed flex-1">{shortDescription}</p>
    <a
      href={href}
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-dark hover:text-brand-accent transition-colors min-h-[44px]"
    >
      View details
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</article>
