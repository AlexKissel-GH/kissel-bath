---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, settings } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogType?: string;
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/images/og-image.jpg',
  ogType = 'website',
  jsonld = [],
  noindex = false,
  preloadImage,
} = Astro.props;

const canonical = new URL(path, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;

// GTM is configurable via Decap CMS → Site Settings → "Google Tag Manager ID".
// It is never rendered into the HTML directly; a loader injects it only after
// the visitor accepts the cookie-consent bar (localStorage "kissel-consent").
const gtmId = (settings.gtmId || '').trim();
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- dataLayer exists before any tracker so events can be queued pre-GTM -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>
    {gtmId && (
      <>
        <script is:inline set:html={`window.__GTM_ID=${JSON.stringify(gtmId)};`} />
        <script is:inline>
          (function () {
            var loaded = false;
            window.__loadGTM = function () {
              if (loaded || !window.__GTM_ID) return;
              loaded = true;
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(window.__GTM_ID);
              document.head.appendChild(s);
            };
            try {
              if (localStorage.getItem('kissel-consent') === 'accepted') window.__loadGTM();
            } catch (e) {}
          })();
        </script>
      </>
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Kissel's Bath and Kitchen" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {jsonld.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>

  <body class="font-sans text-brand-body antialiased bg-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-dark focus:text-white focus:rounded-lg"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <!-- Site-wide interaction tracking → dataLayer (works before GTM loads).
         click_location comes from the nearest ancestor with a data-track attr. -->
    <script is:inline>
      (function () {
        document.addEventListener('click', function (e) {
          var t = e.target;
          var a = t && t.closest ? t.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var locEl = a.closest('[data-track]');
          window.dataLayer = window.dataLayer || [];
          function push(event) {
            var payload = { event: event };
            if (locEl) payload.click_location = locEl.getAttribute('data-track');
            window.dataLayer.push(payload);
          }
          if (href.indexOf('tel:') === 0) push('tel_click');
          else if (href.indexOf('mailto:') === 0) push('email_click');
          else if (href.indexOf('sms:') === 0) push('sms_click');
          else if (/google\.com\/maps/.test(href)) push('gbp_click');
          else if (/facebook\.com|houzz\.com/.test(href)) push('social_click');
        });
      })();
    </script>
  </body>
</html>
