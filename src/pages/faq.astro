---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { settings, faqPageJsonLd, breadcrumbList } from '../lib/seo';

const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

const categories = [
  'Pricing & Estimates',
  'Timeline & Process',
  'Products & Materials',
  'Accessibility & Special Needs',
  'Warranty & Aftercare',
];

const grouped = categories
  .map((cat) => ({ category: cat, items: faqs.filter((f) => f.data.category === cat) }))
  .filter((g) => g.items.length > 0);

const jsonld = [
  faqPageJsonLd(faqs.map((f) => ({ question: f.data.question, answer: f.body.trim() }))),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]),
];
---

<BaseLayout
  title="FAQ — Bathroom & Kitchen Remodeling Denver | Kissel's Bath and Kitchen"
  description="Answers to common questions about bathroom & kitchen remodeling in Denver. Pricing, timeline, materials, financing, warranty & more. Call 720.705.1461."
  path="/faq"
  jsonld={jsonld}
>
  <section class="bg-brand-surface border-b border-slate-200" aria-labelledby="page-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-18">
      <nav class="text-sm text-brand-muted" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-brand-dark transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-dark font-medium" aria-current="page">FAQ</li>
        </ol>
      </nav>
      <h1 id="page-heading" class="mt-4 text-4xl md:text-5xl font-bold text-brand-dark tracking-tight">
        Frequently Asked Questions
      </h1>
      <p class="mt-4 text-lg max-w-2xl">
        Straight answers about pricing, timelines, materials, financing, and warranties.
        Can't find your question? Call us at <a href={settings.phoneHref} class="font-semibold text-emerald-700 hover:text-emerald-800">{settings.phone}</a>.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-16" aria-label="Questions and answers">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {grouped.map((group) => (
        <div>
          <h2 class="text-2xl font-bold text-brand-dark tracking-tight">{group.category}</h2>
          <div class="mt-5 space-y-3">
            {group.items.map((faq) => (
              <details class="group bg-white rounded-2xl border border-slate-200 open:border-slate-300 open:shadow-sm">
                <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-4 min-h-[44px] font-semibold text-brand-dark hover:text-brand-accent transition-colors">
                  <span>{faq.data.question}</span>
                  <svg class="faq-chevron w-5 h-5 shrink-0 text-brand-muted transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </summary>
                <div class="px-6 pb-5 text-sm leading-relaxed">
                  <p>{faq.body.trim()}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTASection
    heading="Still have questions?"
    subheading="Get answers specific to your home with a free, no-obligation in-home consultation."
  />
</BaseLayout>
