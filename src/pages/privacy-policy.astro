---
import BaseLayout from '../layouts/BaseLayout.astro';
import { settings, breadcrumbList } from '../lib/seo';

const jsonld = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Privacy Policy', path: '/privacy-policy' },
  ]),
];
---

<BaseLayout
  title="Privacy Policy | Kissel's Bath and Kitchen"
  description="Privacy Policy for Kissel's Bath and Kitchen — what data we collect, how we use it, your Colorado Privacy Act rights, and how to contact us."
  path="/privacy-policy"
  jsonld={jsonld}
>
  <section class="bg-brand-surface border-b border-slate-200" aria-labelledby="page-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-18">
      <nav class="text-sm text-brand-muted" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-brand-dark transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-dark font-medium" aria-current="page">Privacy Policy</li>
        </ol>
      </nav>
      <h1 id="page-heading" class="mt-4 text-4xl md:text-5xl font-bold text-brand-dark tracking-tight">
        Privacy Policy
      </h1>
      <p class="mt-4 text-lg max-w-2xl">Last updated: September 24, 2026</p>
    </div>
  </section>

  <section class="py-14 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-slate max-w-none
      prose-headings:text-brand-dark prose-headings:tracking-tight
      prose-a:text-emerald-700 prose-a:font-semibold hover:prose-a:text-emerald-800">

      <p>
        Kissel's Bath and Kitchen ("we", "us", "our") operates the website kisselremodeling.com.
        This Privacy Policy explains what information we collect, how we use it, who we share it with,
        and the rights you have — including under the Colorado Privacy Act (CPA).
      </p>

      <h2>Information we collect</h2>
      <h3>Information you provide through forms</h3>
      <p>When you request a free estimate or contact us through a form on this site, we collect:</p>
      <ul>
        <li>Full name</li>
        <li>Phone number</li>
        <li>Email address (optional on some forms)</li>
        <li>ZIP code</li>
        <li>Your message or project details</li>
        <li>The service you are interested in</li>
      </ul>

      <h3>Information collected automatically (analytics)</h3>
      <p>
        If you accept cookies via our consent banner, we use Google Analytics 4 (GA4) via Google Tag
        Manager to collect anonymized usage data such as pages visited, time on site, approximate
        location, and device type. Analytics cookies are only activated after your explicit consent.
        If you decline, no analytics cookies are set.
      </p>

      <h2>How we use your information</h2>
      <ul>
        <li>To process your estimate request and schedule your free in-home consultation</li>
        <li>To call or text you back about your project</li>
        <li>To analyze website performance and improve our content (analytics)</li>
        <li>Possibly for Google Ads remarketing — showing our ads to past visitors on Google properties</li>
      </ul>
      <p>We do not sell your personal information for money.</p>

      <h2>Third parties we work with</h2>
      <ul>
        <li><strong>Netlify</strong> — hosts this website and processes form submissions on our behalf.</li>
        <li><strong>Google Analytics / Google Tag Manager</strong> — website analytics (only after consent).</li>
        <li><strong>Google Ads</strong> — possible remarketing (only after consent).</li>
      </ul>

      <h2>SMS consent</h2>
      <p>
        By providing your phone number and checking the consent box on our forms, you agree to receive
        calls and text messages from Kissel's Bath and Kitchen about your project. Message and data
        rates may apply. You can opt out at any time by replying <strong>STOP</strong> to any text
        message, or by asking us during a call. Opting out will not affect your ability to receive an
        estimate.
      </p>

      <h2>Your rights under the Colorado Privacy Act</h2>
      <p>If you are a Colorado resident, you have the right to:</p>
      <ul>
        <li><strong>Access</strong> — request a copy of the personal data we hold about you.</li>
        <li><strong>Deletion</strong> — ask us to delete your personal data.</li>
        <li><strong>Opt out</strong> — of the sale of personal data, targeted advertising, or profiling.</li>
      </ul>
      <p>
        To exercise any of these rights, email us at
        <a href={`mailto:${settings.email}`}>{settings.email}</a> with the subject line
        "Privacy Request". We will respond within 45 days as required by law.
      </p>

      <h2>Data retention &amp; security</h2>
      <p>
        We keep form submissions only as long as needed to handle your request and maintain our
        business records, after which they are deleted. We use reasonable technical and organizational
        measures (HTTPS, access controls) to protect your information. No method of transmission over
        the internet is 100% secure, but we work to protect your data.
      </p>

      <h2>Cookies &amp; your choices</h2>
      <p>
        You can change your cookie choice at any time using the "Manage cookies" link in the footer of
        every page. Declining cookies will not affect your ability to browse the site or request an
        estimate.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        We may update this Privacy Policy from time to time. The "Last updated" date at the top of
        this page shows when it was last revised.
      </p>

      <h2>Contact us</h2>
      <p>
        Kissel's Bath and Kitchen<br />
        {settings.address}<br />
        Phone: <a href={settings.phoneHref}>{settings.phone}</a><br />
        Email: <a href={`mailto:${settings.email}`}>{settings.email}</a>
      </p>

      <p class="text-sm text-brand-muted border-t border-slate-200 pt-6 mt-10">
        This policy is provided for informational purposes and does not constitute legal advice.
      </p>
    </div>
  </section>
</BaseLayout>
