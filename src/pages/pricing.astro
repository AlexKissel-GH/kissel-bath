---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { offerCatalogJsonLd, breadcrumbList } from '../lib/seo';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const bathroomServices = services.filter((s) => s.data.category === 'bathroom');
const kitchenServices = services.filter((s) => s.data.category === 'kitchen');

const alwaysIncluded = [
  'Free in-home consultation & detailed written estimate',
  'Removal and disposal of old materials',
  'All labor, plumbing, and electrical work',
  'Daily jobsite cleanup and protection of adjacent areas',
  '1-year workmanship warranty',
  'Manufacturer warranties on all products',
  'Final walkthrough and punch-list resolution',
];

const notIncluded = [
  'Permits and inspections (quoted separately if required)',
  'Structural repairs, mold remediation, or asbestos abatement',
  'Appliances (unless specified in kitchen package)',
  'Moving or modifying load-bearing walls',
  'Window or door replacement outside project scope',
  'HOA approvals or architectural review fees',
];

const jsonld = [
  offerCatalogJsonLd(services, 'Bathroom & Kitchen Remodeling Pricing'),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Pricing', path: '/pricing' },
  ]),
];
---

<BaseLayout
  title="Pricing — Bathroom & Kitchen Remodeling Denver | Kissel's Bath and Kitchen"
  description="Transparent remodeling pricing in Denver. Budget shower from $9,000. Complete bathroom from $19,700. Kitchen facelift from $7,900. No hidden fees. Free estimate."
  path="/pricing"
  jsonld={jsonld}
>
  <section class="bg-brand-surface border-b border-slate-200" aria-labelledby="page-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-18">
      <nav class="text-sm text-brand-muted" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-brand-dark transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-dark font-medium" aria-current="page">Pricing</li>
        </ol>
      </nav>
      <h1 id="page-heading" class="mt-4 text-4xl md:text-5xl font-bold text-brand-dark tracking-tight">
        Transparent Remodeling Pricing
      </h1>
      <p class="mt-4 text-lg max-w-2xl">
        No surprises. No hidden fees. See exact packages before we meet. Every estimate is fixed, itemized, and tailored to your space.
      </p>
    </div>
  </section>

  {
    [
      { label: 'Bathroom Packages', items: bathroomServices },
      { label: 'Kitchen Packages', items: kitchenServices },
    ].map((group) => (
      <section class="py-14 md:py-16" aria-labelledby={`${group.label.toLowerCase().replace(/[^a-z]+/g, '-')}-heading`}>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2
            id={`${group.label.toLowerCase().replace(/[^a-z]+/g, '-')}-heading`}
            class="text-2xl md:text-3xl font-bold text-brand-dark tracking-tight"
          >
            {group.label}
          </h2>
          <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.items.map((service) => (
              <article class="relative flex flex-col bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg hover:border-slate-300 transition-all">
                {service.data.featured && (
                  <span class="absolute -top-3 left-6 inline-flex items-center px-3 py-1 rounded-full bg-brand-accent text-white text-xs font-semibold uppercase tracking-wide">
                    Most Popular
                  </span>
                )}
                <h3 class="text-lg font-bold text-brand-dark">{service.data.title}</h3>
                <div class="mt-2 flex items-baseline gap-3">
                  <span class="text-2xl font-bold text-brand-accent">{service.data.priceLabel}</span>
                </div>
                <p class="mt-1 text-sm text-brand-muted">Timeline: {service.data.duration}</p>
                <ul class="mt-4 space-y-2 text-sm flex-1">
                  {service.data.includes.slice(0, 6).map((item) => (
                    <li class="flex items-start gap-2">
                      <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
                <a
                  href="/contact"
                  class="mt-6 inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-brand-dark text-white text-sm font-semibold rounded-xl hover:bg-slate-800 transition-colors"
                >
                  Get Estimate
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- COMPARISON TABLE -->
  <section class="py-14 md:py-16 bg-brand-surface" aria-labelledby="compare-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="compare-heading" class="text-2xl md:text-3xl font-bold text-brand-dark tracking-tight">
        Package Comparison
      </h2>
      <div class="mt-8 overflow-x-auto bg-white rounded-2xl border border-slate-200">
        <table class="w-full text-sm text-left min-w-[640px]">
          <thead class="bg-brand-dark text-white">
            <tr>
              <th scope="col" class="px-6 py-4 font-semibold">Package</th>
              <th scope="col" class="px-6 py-4 font-semibold">Starting Price</th>
              <th scope="col" class="px-6 py-4 font-semibold">Timeline</th>
              <th scope="col" class="px-6 py-4 font-semibold">Scope</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {services.map((service) => (
              <tr class="hover:bg-brand-surface transition-colors">
                <th scope="row" class="px-6 py-4 font-semibold text-brand-dark">
                  <a href={`/services#${service.slug}`} class="hover:text-brand-accent transition-colors">
                    {service.data.title}
                  </a>
                </th>
                <td class="px-6 py-4 font-semibold text-brand-accent">{service.data.priceLabel}</td>
                <td class="px-6 py-4">{service.data.duration}</td>
                <td class="px-6 py-4 text-brand-muted">{service.data.includes[0]} &amp; more</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- INCLUDED / NOT INCLUDED -->
  <section class="py-14 md:py-16" aria-labelledby="included-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="included-heading" class="text-2xl md:text-3xl font-bold text-brand-dark tracking-tight">
        What's included in every project
      </h2>
      <div class="mt-8 grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8">
          <h3 class="font-bold text-emerald-700">Always Included</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {alwaysIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8">
          <h3 class="font-bold text-brand-dark">Not Included (Unless Specified)</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {notIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-brand-muted">
            If any of these apply to your project, we'll identify them during the free consultation and include them in your fixed estimate.
          </p>
        </div>
      </div>

      <!-- Financing -->
      <div class="mt-8 bg-brand-dark rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold text-white">Easy Financing Available</h3>
          <p class="mt-2 text-slate-300 max-w-xl">
            We offer flexible financing options with low interest rates — including 0% APR for 18 months for qualified buyers —
            and soft credit inquiries that won't affect your score.
          </p>
        </div>
        <a
          href="/contact"
          class="shrink-0 inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-brand-accent text-white font-semibold rounded-xl hover:bg-amber-700 transition-colors"
        >
          Ask About Financing
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
