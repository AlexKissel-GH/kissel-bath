---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { servicesPageJsonLd, breadcrumbList } from '../lib/seo';
import { servicePageUrl } from '../lib/serviceUrls';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const bathroomServices = services.filter((s) => s.data.category === 'bathroom');
const kitchenServices = services.filter((s) => s.data.category === 'kitchen');

const jsonld = [
  servicesPageJsonLd(services),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services' },
  ]),
];
---

<BaseLayout
  title="Services — Bathroom & Kitchen Remodeling Denver | Kissel's Bath and Kitchen"
  description="Full list of remodeling services in Denver: Budget Shower ($9K), Complete Bathroom ($19.7K), Tub-to-Shower, Kitchen, ADA Accessibility. Free estimates. Call 720.705.1461."
  path="/services"
  jsonld={jsonld}
>
  <section class="bg-brand-surface border-b border-slate-200" aria-labelledby="page-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-18">
      <nav class="text-sm text-brand-muted" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-brand-dark transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-dark font-medium" aria-current="page">Services</li>
        </ol>
      </nav>
      <h1 id="page-heading" class="mt-4 text-4xl md:text-5xl font-bold text-brand-dark tracking-tight">
        Bathroom &amp; Kitchen Remodeling Services
      </h1>
      <p class="mt-4 text-lg max-w-2xl">
        Ten transparent packages with fixed pricing and fast timelines. Every estimate is free, itemized, and tailored to your space.
      </p>
    </div>
  </section>

  {
    [
      { label: 'Bathroom Remodeling Services', items: bathroomServices },
      { label: 'Kitchen Remodeling Services', items: kitchenServices },
    ].map((group) => (
      <section class="py-14 md:py-16" aria-labelledby={`${group.label.toLowerCase().replace(/[^a-z]+/g, '-')}-heading`}>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2
            id={`${group.label.toLowerCase().replace(/[^a-z]+/g, '-')}-heading`}
            class="text-2xl md:text-3xl font-bold text-brand-dark tracking-tight"
          >
            {group.label}
          </h2>
          <div class="mt-8 space-y-8">
            {group.items.map((service) => (
              <article
                id={service.slug}
                class="scroll-mt-24 grid md:grid-cols-3 bg-white rounded-2xl border border-slate-200 overflow-hidden"
              >
                <div class="relative">
                  {service.data.featured && (
                    <span class="absolute top-4 left-4 z-10 inline-flex items-center px-3 py-1 rounded-full bg-brand-accent text-white text-xs font-semibold uppercase tracking-wide">
                      Most Popular
                    </span>
                  )}
                  <img
                    src={service.data.image}
                    alt={service.data.imageAlt}
                    width="1024"
                    height="768"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full min-h-[220px] object-cover"
                  />
                </div>
                <div class="md:col-span-2 p-6 md:p-8">
                  <a
                    href={servicePageUrl(service.slug)}
                    class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-dark hover:text-brand-accent transition-colors min-h-[44px]"
                  >
                    Learn more
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <h3 class="text-xl md:text-2xl font-bold text-brand-dark">{service.data.title}</h3>
                    <span class="font-semibold text-brand-accent">{service.data.priceLabel}</span>
                    <span class="text-sm text-brand-muted">Timeline: {service.data.duration}</span>
                  </div>
                  <p class="mt-3 leading-relaxed">{service.data.shortDescription}</p>
                  <h4 class="mt-5 text-sm font-semibold text-brand-dark uppercase tracking-wider">What's included</h4>
                  <ul class="mt-3 grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
                    {service.data.includes.map((item) => (
                      <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                  <div class="mt-6 flex flex-wrap gap-3">
                    <a
                      href="/contact"
                      class="inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-brand-dark text-white text-sm font-semibold rounded-xl hover:bg-slate-800 transition-colors"
                    >
                      Get Estimate
                    </a>
                    <a
                      href="/pricing"
                      class="inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-white text-brand-dark text-sm font-semibold rounded-xl border border-slate-300 hover:border-slate-400 transition-colors"
                    >
                      Compare Pricing
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <CTASection />
</BaseLayout>
