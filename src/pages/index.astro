---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import BlogCard from '../components/BlogCard.astro';
import CTASection from '../components/CTASection.astro';
import LeadForm from '../components/LeadForm.astro';
import Stars from '../components/Stars.astro';
import { settings, businessJsonLd, breadcrumbList } from '../lib/seo';

const GBP_URL =
  "https://www.google.com/maps/place/Kissel's+Bath+for+US/@39.7196944,-104.7925253,17z/data=!4m6!3m5!1s0x876c7dca5fdaf431:0xc0d4d25ad129929e!8m2!3d39.7196944!4d-104.7925253!16s%2Fg%2F11h94tpl17";

// City chips that link to dedicated location pages (created in phase 2).
const CITY_LINKS: Record<string, string> = {
  'Aurora, CO': '/locations/bathroom-remodeling-aurora-co/',
  'Parker, CO': '/locations/bathroom-remodeling-parker-co/',
  'Highlands Ranch, CO': '/locations/bathroom-remodeling-highlands-ranch-co/',
  'Lakewood, CO': '/locations/bathroom-remodeling-lakewood-co/',
  'Littleton, CO': '/locations/bathroom-remodeling-littleton-co/',
};

const home = await getEntry('pages', 'home');
const { heroBadge, heroHeading, heroSubheading } = home!.data;

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const bathroomServices = services.filter((s) => s.data.category === 'bathroom');
const kitchenServices = services.filter((s) => s.data.category === 'kitchen');

const allTestimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const homeTestimonials = allTestimonials.filter((t) => t.data.showOnHome).slice(0, 3);

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const trustItems = [
  { title: `${settings.rating}★ on Google`, sub: `${settings.reviewCount} reviews` },
  { title: 'EPA Lead-Safe Certified', sub: 'Firm NAT-F212803-1' },
  { title: 'Licensed & Insured', sub: 'General Contractor' },
  { title: 'HomeAdvisor Elite', sub: 'Top-Rated Pro' },
  { title: 'Houzz 2024', sub: 'Best of Service' },
];

const whyItems = [
  {
    title: 'Fixed, itemized pricing',
    text: 'Every estimate is written, fixed, and itemized before we start. No low-bids, no surprise charges later.',
  },
  {
    title: 'Fast, respectful crews',
    text: 'Most bathroom projects finish in days, not weeks. We clean up daily and seal off the work area.',
  },
  {
    title: 'Family-owned & local',
    text: 'Alex and Daria Kissel personally oversee every project. Based in Aurora, serving all Denver metro.',
  },
  {
    title: 'Real warranties',
    text: '1-year labor warranty on every installation, plus a lifetime warranty on Sentrel composite walls.',
  },
];

const jsonld = [
  businessJsonLd({ reviews: allTestimonials.map((t) => t.data) }),
  breadcrumbList([{ name: 'Home', path: '/' }]),
];
---

<BaseLayout
  title="Bathroom & Kitchen Remodeling Denver, CO | Kissel's Bath and Kitchen"
  description="Family-owned bathroom & kitchen remodeling in Denver, CO. Projects from $9,000. Free in-home estimates. Licensed, insured & EPA certified. Call 720.705.1461."
  path="/"
  jsonld={jsonld}
  preloadImage="/images/hero-bathroom.webp"
>
   <!-- HERO -->
  <section class="bg-gradient-to-b from-brand-surface to-white" aria-labelledby="hero-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-20">
      <div class="grid lg:grid-cols-2 gap-6 lg:gap-14 items-center">
        <div>
          <p class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium text-brand-body shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
            {heroBadge}
          </p>
          <h1 id="hero-heading" class="mt-4 text-[26px] md:text-5xl font-bold text-brand-dark tracking-tight leading-tight">
            {heroHeading}
          </h1>
          <p class="mt-3 md:mt-5 text-base md:text-lg leading-relaxed">{heroSubheading}</p>
          <div class="mt-8 hidden md:flex gap-4" data-track="hero">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-8 py-4 min-h-[44px] bg-brand-dark text-white font-semibold rounded-xl hover:bg-slate-800 transition-colors"
            >
              Get My Free Estimate
            </a>
            <a
              href={settings.phoneHref}
              class="inline-flex items-center justify-center gap-2 px-8 py-4 min-h-[44px] bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition-colors"
              aria-label={`Call us at ${settings.phone}`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              {settings.phone}
            </a>
          </div>
          <div class="mt-4 md:mt-6 flex items-center gap-2 text-sm text-brand-muted">
            <Stars rating={5} />
            <span>{settings.rating} on Google · {settings.reviewCount} reviews</span>
          </div>
        </div>
        <div>
          <img
            src="/images/hero-bathroom.webp"
            alt="Beautifully remodeled bathroom with walk-in shower and composite stone-look walls by Kissel's Bath and Kitchen"
            width="2048"
            height="1152"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full rounded-2xl shadow-xl aspect-video object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="border-y border-slate-200 bg-white" aria-label="Credentials and awards">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 text-center">
        {trustItems.map((item) => (
          <li>
            <div class="font-bold text-brand-dark">{item.title}</div>
            <div class="text-sm text-brand-muted mt-1">{item.sub}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="py-16 md:py-20" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 id="services-heading" class="text-[26px] md:text-4xl font-bold text-brand-dark tracking-tight leading-tight">
          Bathroom &amp; Kitchen Remodeling Services
        </h2>
        <p class="mt-4 text-lg">
          Transparent packages with fixed pricing and fast timelines. From a one-day surround facelift to a full kitchen transformation.
        </p>
      </div>

      <h3 class="mt-12 text-xl font-bold text-brand-dark">Bathroom Remodeling</h3>
      <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {bathroomServices.map((service) => <ServiceCard service={service} />)}
      </div>

      <h3 class="mt-12 text-xl font-bold text-brand-dark">Kitchen Remodeling</h3>
      <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {kitchenServices.map((service) => <ServiceCard service={service} />)}
      </div>

      <div class="mt-10 text-center">
        <a href="/services" class="inline-flex items-center gap-2 font-semibold text-brand-dark hover:text-brand-accent transition-colors min-h-[44px]">
          Explore all services in detail
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="py-16 md:py-20 bg-brand-surface" aria-labelledby="why-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 id="why-heading" class="text-3xl md:text-4xl font-bold text-brand-dark tracking-tight">
          Why Denver homeowners choose Kissel's
        </h2>
        <p class="mt-4 text-lg">200+ completed projects across Denver metro — and a reputation built one happy homeowner at a time.</p>
      </div>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyItems.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h3 class="font-bold text-brand-dark">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>

      <!-- Financing strip -->
      <div class="mt-10 bg-brand-dark rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold text-white">Easy financing available</h3>
          <p class="mt-2 text-slate-300 max-w-xl">
            Flexible financing options with low interest rates — including 0% APR for 18 months for qualified buyers.
            The application uses a soft credit inquiry that won't affect your credit score.
          </p>
        </div>
        <a
          href="/contact"
          class="shrink-0 inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-brand-accent text-white font-semibold rounded-xl hover:bg-amber-700 transition-colors"
        >
          Ask About Financing
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-16 md:py-20" aria-labelledby="testimonials-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 id="testimonials-heading" class="text-3xl md:text-4xl font-bold text-brand-dark tracking-tight">
          What our clients say
        </h2>
        <p class="mt-4 text-lg">{settings.rating}★ average across {settings.reviewCount} Google reviews.</p>
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {homeTestimonials.map((t) => <TestimonialCard testimonial={t} />)}
      </div>
      <div class="mt-10 text-center">
        <a
          href={GBP_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] bg-brand-dark text-white font-semibold rounded-xl hover:bg-slate-800 transition-colors"
        >
          Read our {settings.reviewCount} reviews on Google →
        </a>
      </div>
    </div>
  </section>

  <!-- LEAD FORM -->
  <section class="py-16 md:py-20 bg-brand-surface" aria-labelledby="lead-form-heading">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-10 shadow-sm" data-track="lead-form">
        <div class="text-center max-w-xl mx-auto">
          <h2 id="lead-form-heading" class="text-3xl md:text-4xl font-bold text-brand-dark tracking-tight">
            Get your free in-home estimate
          </h2>
          <p class="mt-4 text-lg">Fixed, itemized pricing — no obligation.</p>
        </div>
        <div class="mt-8">
          <LeadForm formLocation="home" />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section id="service-areas" class="py-16 md:py-20 bg-brand-surface" aria-labelledby="areas-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 id="areas-heading" class="text-3xl md:text-4xl font-bold text-brand-dark tracking-tight">
          Serving the Denver metro area
        </h2>
        <p class="mt-4 text-lg">Based in Aurora, CO — proudly remodeling homes across the Front Range.</p>
      </div>
      <ul class="mt-8 flex flex-wrap gap-3">
        {[...settings.serviceAreas, ...settings.extendedServiceAreas].map((area) => (
          <li>
            {CITY_LINKS[area] ? (
              <a
                href={CITY_LINKS[area]}
                class="inline-flex items-center px-4 py-2 min-h-[44px] bg-white border border-slate-200 rounded-full text-sm font-medium text-brand-body hover:text-brand-dark hover:border-slate-300 transition-colors"
              >
                {area.replace(', CO', '')}
              </a>
            ) : (
              <span class="inline-flex items-center px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-medium text-brand-body">
                {area.replace(', CO', '')}
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FROM OUR BLOG -->
  {latestPosts.length > 0 && (
    <section class="py-16 md:py-20" aria-labelledby="blog-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <h2 id="blog-heading" class="text-3xl md:text-4xl font-bold text-brand-dark tracking-tight">
            From our blog
          </h2>
          <p class="mt-4 text-lg">
            Real costs, honest timelines, and practical remodeling advice for Denver metro homeowners.
          </p>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => <BlogCard post={post} />)}
        </div>
        <div class="mt-10 text-center">
          <a href="/blog" class="inline-flex items-center gap-2 font-semibold text-brand-dark hover:text-brand-accent transition-colors min-h-[44px]">
            Read all articles
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <CTASection>
    <LeadForm slot="form" formLocation="home-bottom" compact />
  </CTASection>
</BaseLayout>
