---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { settings, businessJsonLd, breadcrumbList } from '../lib/seo';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const bathroomServices = services.filter((s) => s.data.category === 'bathroom');
const kitchenServices = services.filter((s) => s.data.category === 'kitchen');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    mainEntity: businessJsonLd(),
  },
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
];

const inputClass =
  'w-full px-4 py-3 min-h-[44px] rounded-xl border border-slate-300 bg-white text-brand-dark placeholder:text-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-brand-accent transition-colors';
const labelClass = 'block text-sm font-semibold text-brand-dark mb-1.5';
---

<BaseLayout
  title="Free In-Home Estimate — Denver Remodeling | Kissel's Bath and Kitchen"
  description="Schedule your free in-home estimate in Denver, Aurora & Highlands Ranch. Licensed, insured & EPA certified. Call 720.705.1461 or fill out the form."
  path="/contact"
  jsonld={jsonld}
>
  <section class="bg-brand-surface border-b border-slate-200" aria-labelledby="page-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-18">
      <nav class="text-sm text-brand-muted" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-brand-dark transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-brand-dark font-medium" aria-current="page">Contact</li>
        </ol>
      </nav>
      <h1 id="page-heading" class="mt-4 text-4xl md:text-5xl font-bold text-brand-dark tracking-tight">
        Get your free in-home estimate
      </h1>
      <p class="mt-4 text-lg max-w-2xl">
        Schedule a no-obligation consultation. We serve all Denver metro.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-16" aria-label="Estimate request form and contact details">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-3 gap-10">
      <!-- FORM -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8">
          <h2 class="text-2xl font-bold text-brand-dark">Request a consultation</h2>
          <p class="mt-2 text-sm text-brand-muted">
            Fields marked * are required. We will never share your information. Licensed &amp; insured.
          </p>

          <!-- Netlify Forms: this form is detected at deploy time and only works when deployed on Netlify.
               Locally it will simply navigate to /thank-you without storing the submission. -->
          <form
            name="estimate"
            method="POST"
            action="/thank-you"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="mt-6 grid sm:grid-cols-2 gap-5"
          >
            <input type="hidden" name="form-name" value="estimate" />
            <p class="hidden" aria-hidden="true">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div>
              <label for="name" class={labelClass}>Full name *</label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder="John Smith" class={inputClass} />
            </div>
            <div>
              <label for="phone" class={labelClass}>Phone *</label>
              <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(720) 705-1461" class={inputClass} />
            </div>
            <div>
              <label for="email" class={labelClass}>Email *</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="john@example.com" class={inputClass} />
            </div>
            <div>
              <label for="service" class={labelClass}>Service options</label>
              <select id="service" name="service" class={inputClass}>
                <optgroup label="Bathroom Services">
                  {bathroomServices.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
                </optgroup>
                <optgroup label="Kitchen Services">
                  {kitchenServices.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
                </optgroup>
                <option value="Not sure yet — need consultation">Not sure yet — need consultation</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="address" class={labelClass}>Project address *</label>
              <input type="text" id="address" name="address" required autocomplete="street-address" placeholder="123 Main St" class={inputClass} />
            </div>
            <div>
              <label for="city" class={labelClass}>City *</label>
              <input type="text" id="city" name="city" required autocomplete="address-level2" placeholder="Denver" class={inputClass} />
            </div>
            <div>
              <label for="zip" class={labelClass}>ZIP code *</label>
              <input type="text" id="zip" name="zip" required autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}" placeholder="80011" class={inputClass} />
            </div>
            <div class="sm:col-span-2">
              <label for="message" class={labelClass}>Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us about your project…" class={`${inputClass} min-h-[120px]`}></textarea>
            </div>
            <div class="sm:col-span-2">
              <button
                type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 min-h-[44px] bg-brand-dark text-white font-semibold rounded-xl hover:bg-slate-800 transition-colors"
              >
                Request Estimate
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- SIDEBAR -->
      <aside class="space-y-6" aria-label="Contact information">
        <div class="bg-brand-dark rounded-2xl p-6 md:p-8 text-slate-300">
          <h2 class="text-lg font-bold text-white">Contact info</h2>
          <ul class="mt-5 space-y-4 text-sm">
            <li>
              <a href={settings.phoneHref} class="inline-flex items-center gap-3 text-emerald-400 font-semibold text-base hover:text-emerald-300 transition-colors min-h-[44px]">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                {settings.phone}
              </a>
            </li>
            <li>
              <a href={`mailto:${settings.email}`} class="inline-flex items-center gap-3 hover:text-white transition-colors break-all min-h-[44px]">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                {settings.email}
              </a>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              {settings.address}
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {settings.hours}
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8">
          <h2 class="text-lg font-bold text-brand-dark">Service areas</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {settings.serviceAreas.map((area) => (
              <li class="px-3 py-1.5 bg-brand-surface border border-slate-200 rounded-full text-sm font-medium text-brand-body">
                {area.replace(', CO', '')}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-brand-muted">
            Plus {settings.extendedServiceAreas.length} more communities across the Denver metro — call to confirm yours.
          </p>
        </div>

        <div class="bg-brand-surface rounded-2xl border border-slate-200 p-6 md:p-8">
          <h2 class="text-lg font-bold text-brand-dark">Prefer to talk?</h2>
          <p class="mt-2 text-sm">
            Call or text us during business hours — Alex or Daria will personally answer your questions.
          </p>
          <a
            href={settings.phoneHref}
            class="mt-4 inline-flex items-center justify-center gap-2 w-full px-6 py-3 min-h-[44px] bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition-colors"
            aria-label={`Call us at ${settings.phone}`}
          >
            Call {settings.phone}
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
